  // Time: O(max(m, n)), Space: O(max(m, n))
  public ListNode addTwoLinkedListNumbers(ListNode l1, ListNode l2) {
    ListNode dummy = new ListNode(0), p = dummy;
    int carry = 0;
    while (l1 != null || l2 != null || carry != 0) {
